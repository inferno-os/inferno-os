.TH LETHEFS 4
.SH NAME
lethefs, lethed \- stateless read-only file service (Lethe)
.SH SYNOPSIS
.B lethefs
[
.B -ADN
] [
.B -C
.I alg
] [
.B -k
.I keyfile
] [
.B -t
.I ms
] [
.B -u
.I user
]
.I addr
.I mtpt
.PP
.B lethed
[
.B -vA
] [
.B -C
.I alg
] [
.B -a
.I addr
] [
.B -u
.I owner
] [
.B -t
.I ticketkey
] [
.B -e
.I lifetime
] [
.B -w
.I window
] [
.B -k
